{
	"info": {
		"_postman_id": "fitform-master-category-api-v1",
		"name": "FITFORM - Master Kategori API",
		"description": "Koleksi Web Service Master Kategori Latihan (Exercise Categories) pada FITFORM Backend.\nLengkap dengan autentikasi Laravel Sanctum dan Role-Based Access Control (Admin & User).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000/api",
			"type": "string"
		},
		{
			"key": "admin_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "user_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "category_id",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "1.1 Login sebagai Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('admin_token', jsonData.token);",
									"    console.log('Admin token saved successfully');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@fitform.com\",\n    \"password\": \"password123\",\n    \"device_name\": \"Postman Desktop Client\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"login"
							]
						},
						"description": "Login menggunakan akun default Admin FITFORM untuk mendapatkan Bearer Token Admin."
					},
					"response": []
				},
				{
					"name": "1.2 Login sebagai User Biasa",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('user_token', jsonData.token);",
									"    console.log('User token saved successfully');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@fitform.com\",\n    \"password\": \"password123\",\n    \"device_name\": \"Postman Desktop Client\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"login"
							]
						},
						"description": "Login menggunakan akun User biasa untuk menguji kontrol akses (Read OK, Write Forbidden)."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Master Kategori (CRUD)",
			"item": [
				{
					"name": "2.1 Get All Categories (Read)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/categories",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"categories"
							]
						},
						"description": "Menampilkan seluruh daftar kategori latihan aktif."
					},
					"response": []
				},
				{
					"name": "2.2 Get Categories with Exercises Eager Loading",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/categories?include_exercises=true",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"categories"
							],
							"query": [
								{
									"key": "include_exercises",
									"value": "true"
								}
							]
						},
						"description": "Menampilkan kategori beserta daftar gerakan latihan fisik di dalamnya."
					},
					"response": []
				},
				{
					"name": "2.3 Search Category by Name/Description",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/categories?search=Upper",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"categories"
							],
							"query": [
								{
									"key": "search",
									"value": "Upper"
								}
							]
						},
						"description": "Mencari kategori dengan kata kunci query."
					},
					"response": []
				},
				{
					"name": "2.4 Get Category Detail by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/categories/{{category_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"categories",
								"{{category_id}}"
							]
						},
						"description": "Menampilkan detail satu kategori beserta relasi latihannya."
					},
					"response": []
				},
				{
					"name": "2.5 Create Category (Admin Only - Valid)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set('category_id', jsonData.data.id);",
									"    console.log('Created category ID:', jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Cardio & Endurance\",\n    \"description\": \"Latihan kardiovaskular dan daya tahan tubuh dengan gerakan berulang.\",\n    \"icon\": \"favorite\",\n    \"is_active\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/categories",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"categories"
							]
						},
						"description": "Menambahkan data master kategori baru (Admin Only)."
					},
					"response": []
				},
				{
					"name": "2.6 Create Category (Validation Error - Duplicate Name)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Upper Body\",\n    \"description\": \"Duplikasi nama\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/categories",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"categories"
							]
						},
						"description": "Pengujian error 422 Unprocessable Entity saat mengirimkan nama kategori yang sudah ada."
					},
					"response": []
				},
				{
					"name": "2.7 Update Category (Admin Only)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Cardio & HIIT Endurance\",\n    \"description\": \"Deskripsi kategori diperbarui melalui PUT endpoint API.\",\n    \"is_active\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/categories/{{category_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"categories",
								"{{category_id}}"
							]
						},
						"description": "Memperbarui data kategori (Admin Only)."
					},
					"response": []
				},
				{
					"name": "2.8 Delete Category (Admin Only)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/categories/{{category_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"categories",
								"{{category_id}}"
							]
						},
						"description": "Menghapus kategori (Admin Only)."
					},
					"response": []
				},
				{
					"name": "2.9 Create Category Forbidden Test (Non-Admin User)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{user_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Unauthorized Category\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/categories",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"categories"
							]
						},
						"description": "Memastikan User biasa tidak dapat membuat/mengubah kategori (harus mengembalikan HTTP 403 Forbidden)."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Relasi Exercise & Category",
			"item": [
				{
					"name": "3.1 Filter Exercises by Category ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/exercises?category_id=1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"exercises"
							],
							"query": [
								{
									"key": "category_id",
									"value": "1"
								}
							]
						},
						"description": "Menampilkan latihan yang terhubung ke Category ID tertentu (misal: ID 1 Upper Body)."
					},
					"response": []
				}
			]
		}
	]
}
